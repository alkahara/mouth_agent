page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #020617;
  color: #e2e8f0;
}

button::after {
  border: none;
}

.page-shell {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: linear-gradient(180deg, #0f172a 0%, #020617 100%);
}

.nav-debug-slot {
  display: flex;
  align-items: center;
  height: 100%;
}

.nav-account-slot {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 0 16rpx;
  color: #cbd5e1;
  font-size: 25rpx;
}

.debug-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border: 1rpx solid #334155;
  border-radius: 50%;
  background: transparent;
}

.debug-button--active {
  border-color: #38bdf8;
  background: rgba(56, 189, 248, 0.18);
}

.debug-icon {
  width: 30rpx;
  height: 30rpx;
}

.debug-panel {
  position: fixed;
  z-index: 999;
  left: 24rpx;
  width: 460rpx;
  max-width: calc(100vw - 48rpx);
  padding: 22rpx;
  border: 1rpx solid #1e293b;
  border-radius: 22rpx;
  background: rgba(15, 23, 42, 0.96);
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.55);
}

.debug-panel__arrow {
  position: absolute;
  top: -12rpx;
  left: 40rpx;
  width: 24rpx;
  height: 24rpx;
  border-top: 1rpx solid #1e293b;
  border-left: 1rpx solid #1e293b;
  background: rgba(15, 23, 42, 0.96);
  transform: rotate(45deg);
}

.slot-header {
  display: flex;
  justify-content: space-between;
  font-size: 25rpx;
  font-weight: 600;
}

.slot-count {
  color: #94a3b8;
  font-size: 21rpx;
  font-weight: 400;
}

.progress-track {
  height: 10rpx;
  margin: 18rpx 0;
  overflow: hidden;
  border-radius: 999rpx;
  background: #334155;
}

.progress-value {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #0ea5e9, #34d399);
  transition: width 0.3s ease;
}

.slot-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.slot-item {
  padding: 8rpx 14rpx;
  border: 1rpx solid #334155;
  border-radius: 12rpx;
  background: #1e293b;
  color: #64748b;
  font-size: 20rpx;
}

.slot-item--filled {
  border-color: #047857;
  background: rgba(6, 78, 59, 0.45);
  color: #6ee7b7;
}

.slot-dot {
  margin-right: 6rpx;
}

.triage-card {
  margin-top: 18rpx;
  padding: 18rpx;
  border-left: 8rpx solid #64748b;
  border-radius: 14rpx;
  background: #1e293b;
}

.risk-badge {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  color: #fff;
  font-size: 21rpx;
  font-weight: 700;
}

.care-label {
  margin-top: 14rpx;
  color: #94a3b8;
  font-size: 20rpx;
}

.care-plan {
  margin-top: 4rpx;
  color: #e2e8f0;
  font-family: monospace;
  font-size: 23rpx;
}

.preset-scroll {
  flex: none;
  width: 100%;
  margin: 18rpx 0 4rpx;
  white-space: nowrap;
}

.preset-row {
  display: inline-flex;
  gap: 16rpx;
  padding: 0 24rpx;
}

.preset-chip {
  display: inline-block;
  width: auto;
  max-width: 480rpx;
  margin: 0;
  padding: 0 20rpx;
  height: 58rpx;
  line-height: 58rpx;
  overflow: hidden;
  border: 1rpx solid #334155;
  border-radius: 999rpx;
  background: #1e293b;
  color: #cbd5e1;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-scroll {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  padding: 16rpx 24rpx;
}

.empty-state {
  margin: 100rpx 30rpx;
  padding: 38rpx;
  border: 1rpx dashed #334155;
  border-radius: 22rpx;
  color: #64748b;
  font-size: 25rpx;
  text-align: center;
}

.message-group {
  margin-bottom: 26rpx;
}

.message-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.message-row--user {
  flex-direction: row-reverse;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  background: #334155;
  color: #bae6fd;
  font-size: 22rpx;
  font-weight: 700;
}

.message-row--user .avatar {
  background: #0284c7;
  color: #fff;
}

.message-body {
  max-width: 76%;
}

.message-row--user .message-body {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.message-bubble {
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  background: #1e293b;
  color: #f1f5f9;
  font-size: 28rpx;
  line-height: 1.55;
  white-space: pre-wrap;
  word-break: break-word;
}

.message-row--user .message-bubble {
  background: #0284c7;
  color: #fff;
}

.message-time {
  margin-top: 7rpx;
  color: #64748b;
  font-size: 19rpx;
}

.decision-card {
  margin: 0 80rpx 12rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid #9a3412;
  border-radius: 12rpx;
  background: rgba(124, 45, 18, 0.25);
  color: #fed7aa;
  font-family: monospace;
  font-size: 21rpx;
  line-height: 1.5;
}

.decision-title {
  margin-bottom: 5rpx;
  color: #fb923c;
  font-size: 18rpx;
  text-transform: uppercase;
}

.option-panel,
.video-card {
  margin: 20rpx 24rpx 0;
}

.option-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -10rpx 0;
}

.option-card {
  box-sizing: border-box;
  width: calc((100% - 24rpx) / 2);
  margin: 10rpx 0;
  padding: 18rpx 18rpx 20rpx;
  border: 1rpx solid #334155;
  border-radius: 18rpx;
  background: #0f172a;
  color: #e2e8f0;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: left;
  overflow: hidden;
}

.option-card:nth-child(odd) {
  margin-right: 24rpx;
}

.option-card--hover {
  background: #16243b;
}

.option-card--selected {
  border-color: #38bdf8;
  background: #0c4a6e;
}

.option-card--disabled {
  opacity: 0.45;
}

.option-image {
  display: block;
  width: 100%;
  height: 150rpx;
  margin-bottom: 12rpx;
  border-radius: 12rpx;
  background: #1e293b;
}

.option-image--placeholder {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #64748b;
  font-size: 22rpx;
}

.option-label {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 0 4rpx;
  line-height: 1.5;
}

.option-key {
  flex: none;
  color: #38bdf8;
  font-weight: 700;
}

.option-text {
  flex: 1;
  min-width: 0;
  word-break: break-word;
}

.multi-summary {
  margin-bottom: 12rpx;
  color: #94a3b8;
  font-size: 21rpx;
}

.confirm-button {
  margin: 16rpx 0 0 auto;
  padding: 0 28rpx;
  width: auto;
  height: 66rpx;
  line-height: 66rpx;
  border-radius: 14rpx;
  background: #0284c7;
  color: #fff;
  font-size: 23rpx;
}

.video-card {
  overflow: hidden;
  border: 1rpx solid #334155;
  border-radius: 18rpx;
  background: #0f172a;
}

.direct-video {
  display: block;
  width: 100%;
  min-height: 200rpx;
  background: #000;
}

.video-thumb {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  height: 280rpx;
  background: radial-gradient(circle at 50% 42%, #1e3a5f 0%, #0f172a 72%);
}

.video-thumb--hover {
  opacity: 0.85;
}

.video-thumb__icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(56, 189, 248, 0.92);
  position: relative;
}

.video-thumb__icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 56%;
  transform: translate(-50%, -50%);
  border-style: solid;
  border-width: 22rpx 0 22rpx 36rpx;
  border-color: transparent transparent transparent #f8fafc;
}

.video-thumb__label {
  color: #cbd5e1;
  font-size: 24rpx;
}

.small-button,
.copy-button {
  flex: none;
  width: auto;
  margin: 0;
  padding: 0 18rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 12rpx;
  background: #0284c7;
  color: #fff;
  font-size: 21rpx;
}

.video-password {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 18rpx;
  border-top: 1rpx solid #334155;
  color: #94a3b8;
  font-size: 21rpx;
}

.copy-button {
  height: 48rpx;
  line-height: 48rpx;
  background: #334155;
}

.loading-card,
.error-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 16rpx 80rpx;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background: #1e293b;
  color: #cbd5e1;
  font-size: 23rpx;
}

.loading-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #38bdf8;
}

.error-card {
  border: 1rpx solid #be123c;
  background: rgba(136, 19, 55, 0.3);
  color: #fecdd3;
}

.bottom-anchor {
  height: 30rpx;
}

.composer {
  flex: none;
  display: flex;
  align-items: flex-end;
  gap: 12px;
  padding: 8px 20px calc(8px + env(safe-area-inset-bottom));
  border-top: 1rpx solid #1e293b;
  background: rgba(15, 23, 42, 0.98);
}

.composer-input {
  flex: 1;
  box-sizing: border-box;
  width: auto;
  min-height: 28px;
  max-height: 120px;
  padding: 5px 12px;
  overflow-y: auto;
  border: none;
  border-radius: 8px;
  background: #1e293b;
  color: #f8fafc;
  font-size: 15px;
  line-height: 18px;
}

.composer-button {
  flex: 0 0 48px;
  box-sizing: border-box;
  width: 48px;
  min-width: 48px;
  max-width: 48px;
  margin: 0;
  padding: 0 6px;
  height: 36px;
  line-height: 36px;
  border-radius: 8px;
  font-size: 13px;
  text-align: center;
}

.composer-button::after {
  border: none;
}

.reset-button {
  flex: 0 0 36px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  min-width: 36px;
  max-width: 36px;
  height: 36px;
  border: 1px solid #475569;
  border-radius: 999px;
  background: #1e293b;
}

.reset-button--disabled {
  opacity: 0.45;
}

.reset-icon {
  width: 20px;
  height: 20px;
}

.send-button {
  background: #0284c7;
  color: #fff;
}

button[disabled] {
  opacity: 0.45;
}

.dialog-mask {
  position: fixed;
  z-index: 1000;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(0, 0, 0, 0.72);
}

.dialog {
  box-sizing: border-box;
  width: 100%;
  padding: 30rpx;
  border: 1rpx solid #334155;
  border-radius: 24rpx;
  background: #0f172a;
}

.dialog-title {
  color: #f8fafc;
  font-size: 31rpx;
  font-weight: 700;
}

.dialog-hint {
  margin-top: 10rpx;
  color: #94a3b8;
  font-size: 23rpx;
}

.dialog-input {
  box-sizing: border-box;
  width: 100%;
  height: 180rpx;
  margin-top: 22rpx;
  padding: 18rpx;
  border: 1rpx solid #334155;
  border-radius: 16rpx;
  background: #1e293b;
  color: #f8fafc;
  font-size: 26rpx;
}

.dialog-actions {
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
  margin-top: 22rpx;
}

.dialog-cancel,
.dialog-submit {
  width: auto;
  margin: 0;
  padding: 0 28rpx;
  height: 66rpx;
  line-height: 66rpx;
  border-radius: 14rpx;
  color: #fff;
  font-size: 24rpx;
}

.dialog-cancel {
  background: #334155;
}

.dialog-submit {
  background: #0284c7;
}
