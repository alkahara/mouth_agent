page {
  height: 100%;
  background: #020617;
}

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  gap: 30rpx;
}

.error-text {
  color: #94a3b8;
  font-size: 28rpx;
}

.error-back {
  width: auto;
  margin: 0;
  padding: 0 40rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 14rpx;
  background: #0284c7;
  color: #fff;
  font-size: 26rpx;
}
