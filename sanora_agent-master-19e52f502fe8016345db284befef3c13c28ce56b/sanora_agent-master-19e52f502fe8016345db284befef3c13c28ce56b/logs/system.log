me": "is_surgical_area",\n    "description": "出血部位是否为手术区域",\n    "required": true,\n    "question_template": "请问出血部位是否为手术区域？",\n    "options": [\n      {\n        "key": "A",\n        "label": "是"\n      },\n      {\n        "key": "B",\n        "label": "否"\n      }\n    ]\n  },\n  {\n    "name": "cause_trigger",\n    "description": "出血诱因",\n    "required": true,\n    "question_template": "近期是否有咬硬物、漱口过猛、缝线松动、佩戴义齿/保持器或服用抗凝药等诱因？如果有，请描述具体情况。"\n  },\n  {\n    "name": "latest_time",\n    "description": "术后时间",\n    "required": true,\n    "question_template": "请问出血发生在术后多久？（例如：手术后12小时/3天/一周）"\n  },\n  {\n    "name": "symptom_description",\n    "description": "伴随症状",\n    "required": true,\n    "question_template": "是否伴随伤口疼痛、裂开，或出现发热、乏力、淋巴结肿大等全身症状？",\n    "condition": "slots.get(\'latest_time\', {}).get(\'value\') == \'late\'"\n  },\n  {\n    "name": "surgery_type",\n    "description": "手术类型",\n    "required": true,\n    "question_template": "本次接受了什么手术或治疗？（可多选，最多4项）",\n    "options": [\n      {\n        "key": "A",\n        "label": "II期手术"\n      },\n      {\n        "key": "B",\n        "label": "上颌窦外提升植骨术"\n      },\n      {\n        "key": "C",\n        "label": "上颌窦内提升植骨术"\n      },\n      {\n        "key": "D",\n        "label": "软组织移植术"\n      },\n      {\n        "key": "E",\n        "label": "上颌前牙种植"\n      },\n      {\n        "key": "F",\n        "label": "上颌后牙种植"\n      },\n      {\n        "key": "G",\n        "label": "下颌前牙种植"\n      },\n      {\n        "key": "H",\n        "label": "下颌后牙种植"\n      },\n      {\n        "key": "I",\n        "label": "拔牙即刻种植术"\n      },\n      {\n        "key": "J",\n        "label": "位点保存术"\n      },\n      {\n        "key": "K",\n        "label": "块状骨移植术"\n      },\n      {\n        "key": "L",\n        "label": "骨柱植骨术"\n      },\n      {\n        "key": "M",\n        "label": "引导骨再生技术"\n      },\n      {\n        "key": "N",\n        "label": "上颌无牙颌种植术"\n      },\n      {\n        "key": "O",\n        "label": "下颌无牙颌种植术"\n      },\n      {\n        "key": "P",\n        "label": "种植体取出术"\n      },\n      {\n        "key": "Q",\n        "label": "牙齿拔除术"\n      }\n    ]\n  },\n  {\n    "name": "bleeding_severity",\n    "description": "出血严重程度",\n    "required": true,\n    "question_template": "当前出血表现更接近哪种情况？A. 轻微渗血；B. 伤口持续鲜红出血；C. 其他表现。",\n    "options": [\n      {\n        "key": "A",\n        "label": "轻微渗血",\n        "image_url": "https://sanora.oss-cn-beijing.aliyuncs.com/resources/light_bleed_30k.jpg"\n      },\n      {\n        "key": "B",\n        "label": "伤口持续鲜红出血",\n        "image_url": "https://sanora.oss-cn-beijing.aliyuncs.com/resources/move_bleed.jpg"\n      },\n      {\n        "key": "C",\n        "label": "其他表现",\n        "input_type": "text",\n        "placeholder": "请详细描述您的出血情况（如：出血量、颜色、持续时间等）"\n      }\n    ]\n  },\n  {\n    "name": "bleeding_location",\n    "description": "出血部位",\n    "required": true,\n    "question_template": "请问出血发生在哪个区域？",\n    "options": [\n      {\n        "key": "A",\n        "label": "舌侧（舌头下方、舌底）"\n      },\n      {\n        "key": "B",\n        "label": "腭侧（上颚、上方）"\n      }\n    ],\n    "condition": "slots.get(\'bleeding_severity\', {}).get(\'value\') in [\'active\', \'minor\']"\n  },\n  {\n    "name": "can_compress",\n    "description": "是否可以压迫止血",\n    "required": true,\n    "question_template": "当前部位是否能够使用干净纱布或棉卷进行压迫止血？",\n    "condition": "slots.get(\'bleeding_severity\', {}).get(\'value\') == \'active\'"\n  },\n  {\n    "name": "rebleed_after_compression",\n    "description": "压迫后是否再次出血",\n    "required": true,\n    "question_template": "压迫止血后是否仍然持续或再次出血？",\n    "condition": "slots.get(\'can_compress\', {}).get(\'value\') == \'can\'"\n  }\n]\n\n# 已收集槽位\n\n- 出血部位是否为手术区域: 未收集\n- 出血诱因: 未收集\n- 术后时间: 未收集\n- 伴随症状: 未收集\n- 手术类型: 未收集\n- 出血严重程度: 未收集\n- 出血部位: 未收集\n- 是否可以压迫止血: 未收集\n- 压迫后是否再次出血: 未收集\n\n# 当前待收集槽位\n\n**is_surgical_area**\n\n请判断用户的回答是否包含该槽位的有效信息。\n\n# 对话历史\n\n[\n  {\n    "type": "human",\n    "content": "你好，我种完牙之后流了好多血，还觉得舌头麻，怎么办"\n  },\