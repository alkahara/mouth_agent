me": "is_surgical_area",\n    "description": "出血部位是否为手术区域",\n    "required": true,\n    "question_template": "请问出血部位是否为手术区域？",\n    "options": [\n      {\n        "key": "A",\n        "label": "是"\n      },\n      {\n        "key": "B",\n        "label": "否"\n      }\n    ]\n  },\n  {\n    "name": "cause_trigger",\n    "description": "出血诱因",\n    "required": true,\n    "question_template": "近期是否有咬硬物、漱口过猛、缝线松动、佩戴义齿/保持器或服用抗凝药等诱因？如果有，请描述具体情况。"\n  },\n  {\n    "name": "latest_time",\n    "description": "术后时间",\n    "required": true,\n    "question_template": "请问出血发生在术后多久？（例如：手术后12小时/3天/一周）"\n  },\n  {\n    "name": "symptom_description",\n    "description": "伴随症状",\n    "required": true,\n    "question_template": "是否伴随伤口疼痛、裂开，或出现发热、乏力、淋巴结肿大等全身症状？",\n    "condition": "slots.get(\'latest_time\', {}).get(\'value\') == \'late\'"\n  },\n  {\n    "name": "surgery_type",\n    "description": "手术类型",\n    "required": true,\n    "question_template": "本次接受了什么手术或治疗？（可多选，最多4项）",\n    "options": [\n      {\n        "key": "A",\n        "label": "II期手术"\n      },\n      {\n        "key": "B",\n        "label": "上颌窦外提升植骨术"\n      },\n      {\n        "key": "C",\n        "label": "上颌窦内提升植骨术"\n      },\n      {\n        "key": "D",\n        "label": "软组织移植术"\n      },\n      {\n        "key": "E",\n        "label": "上颌前牙种植"\n      },\n      {\n        "key": "F",\n        "label": "上颌后牙种植"\n      },\n      {\n        "key": "G",\n        "label": "下颌前牙种植"\n      },\n      {\n        "key": "H",\n        "label": "下颌后牙种植"\n      },\n      {\n        "key": "I",\n        "label": "拔牙即刻种植术"\n      },\n      {\n        "key": "J",\n        "label": "位点保存术"\n      },\n      {\n        "key": "K",\n        "label": "块状骨移植术"\n      },\n      {\n        "key": "L",\n        "label": "骨柱植骨术"\n      },\n      {\n        "key": "M",\n        "label": "引导骨再生技术"\n      },\n      {\n        "key": "N",\n        "label": "上颌无牙颌种植术"\n      },\n      {\n        "key": "O",\n        "label": "下颌无牙颌种植术"\n 